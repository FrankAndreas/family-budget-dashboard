# Copy to .env (git ignores it) and fill in. docker compose reads it automatically.

# Signs login tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, the backend uses a random key and everyone is logged out on restart.
SECRET_KEY=

# Optional: PIN for the first parent "Admin", created when the database is empty.
# If unset, a random 4-digit PIN is generated and printed once in the backend log.
INITIAL_ADMIN_PIN=
