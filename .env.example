# Copy to .env next to the compose file (git ignores it). docker compose reads it automatically.
# See README_DOCKER.md for the NAS setup.

# User and group the backend runs as, and that owns ./data.
# On a Synology, the IDs of a DSM user (`id <user>`); default: the image's own user 999:999.
PUID=999
PGID=999

# Port of the app on the host: http://<NAS_IP>:8081
PORT=8081

# Signs login tokens; set it so logins survive updates. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Optional: PIN for the first parent "Admin", created when the database is empty.
# If unset, a random 4-digit PIN is generated and printed once in the backend log.
INITIAL_ADMIN_PIN=

# Optional: de (default) or en. Language of people who haven't picked one in Settings → Logins,
# and of the default categories of a new database.
DEFAULT_LANGUAGE=

# Optional: reading receipts (photo, PDF, e-mail) with the Infomaniak AI service. Empty = off.
# Token: Infomaniak Manager → API tokens, scope "ai-tools" only, with a lifetime. Product ID: AI Tools.
INFOMANIAK_AI_TOKEN=
INFOMANIAK_AI_PRODUCT_ID=
# Optional: the model (default google/gemma-4-31B-it) and AI reads per person and hour (default 30, 0 = off)
RECEIPT_AI_MODEL=
RECEIPT_AI_READS_PER_HOUR=

# Optional: receipt mails forwarded to e.g. invoice@<domain> (Cloudflare Email Worker). Empty = off.
# The same value goes into the worker (npx wrangler secret put INBOUND_SECRET); create it with: openssl rand -hex 32
INBOUND_SECRET=
